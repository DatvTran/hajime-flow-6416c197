# Database Configuration
# Production: Supabase Postgres (see DEPLOY_SUPABASE.md).
#   DATABASE_URL=postgresql://postgres.<ref>:<password>@db.<ref>.supabase.co:5432/postgres?sslmode=require
# Knex migrations require the direct :5432 host (not the transaction pooler :6543).
# Optional local Docker Postgres: npm run db:up && npm run db:migrate
# Distributor isolation is schemas by default (Supabase-safe). Set
# DISTRIBUTOR_ISOLATION=database only for legacy multi-database Fly/local.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=hajime_dev
DB_USER=postgres
DB_PASSWORD=postgres
# DATABASE_URL=
# DISTRIBUTOR_ISOLATION=schema

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication Secrets (generate with: openssl rand -base64 64)
ACCESS_TOKEN_SECRET=change_me_in_production_access_token_secret
REFRESH_TOKEN_SECRET=change_me_in_production_refresh_token_secret
SESSION_SECRET=change_me_in_production_session_secret

# Supabase Auth (when set, login/JWT/password reset use Supabase instead of local JWTs)
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_JWT_SECRET=

# Application
NODE_ENV=development
PORT=4242
# Public URL of the Vite app — used in CRM invitation emails (accept-invite link)
CLIENT_URL=http://localhost:8080

# Transactional email (CRM invites + password reset). Without RESEND_API_KEY the API logs
# links to stdout instead of sending mail (check `delivery` in JSON: email | logged | none).
# RESEND_API_KEY=re_...
# Use an address on a domain you verified in the Resend dashboard (not only onboarding@resend.dev for prod).
# RESEND_FROM_EMAIL=noreply@yourverifiedomain.com

# Feature Flags
FEATURE_FLAG_AUTH_ENABLED=true
FEATURE_FLAG_CSV_ENABLED=true
# Default: DB-primary mode
FEATURE_FLAG_DB_MIGRATION_STAGE=3

# Stripe (existing)
STRIPE_SECRET_KEY=
ALLOWED_ORIGINS=
